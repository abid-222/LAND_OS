# Bangladesh LandOS — Environment Configuration Template
# Duplicate this file as .env for local runtime settings

PROJECT_NAME="Bangladesh LandOS"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# CORS Allowed Origins (JSON array format)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://localhost:8080"]'

# Database Configuration (PostgreSQL with PostGIS and pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="landos_db"
POSTGRES_USER="landos_user"
POSTGRES_PASSWORD="landos_dev_password"
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}"

# Redis (Queues, Caching, Rate Limiting)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://${REDIS_HOST}:${REDIS_PORT}/0"

# Security & Session Authentication
SECRET_KEY="development_secret_key_change_in_production_min_32_bytes_long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"
ALLOW_DEV_MFA_BYPASS=false

# S3 / MinIO Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minio_admin"
MINIO_SECRET_KEY="minio_dev_password"
MINIO_BUCKET="landos-documents"
MINIO_USE_SSL=false

# Worker & ML Configuration
RQ_QUEUE_NAME="landos_default"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
OCR_CONFIDENCE_THRESHOLD=0.65
GUIDE_SIMILARITY_THRESHOLD=0.78

# Map Tile Configuration (Requirement 3.9)
MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

# Demo Credentials (Development Seed Only)
DEMO_PASSWORD="Password123!"
DEMO_MFA_SECRET="JBSWY3DPEHPK3PXP"

# Observability
LOG_LEVEL="INFO"
PROMETHEUS_METRICS_ENABLED=true

